tabbed zathura -e '' -c

# One page per row by default
set pages-per-row 1
set scroll-page-aware true
set scroll-full-overlap 0.01
set guioptions ""
set selection-clipboard clipboard
set render-loading false
set scroll-step 25
set adjust-open "best-fit"

# maps
map h scroll-left
map l scroll-right
map j scroll-down
map k scroll-up

map gg goto-first-page
map G  goto-last-page

map = zoom in
map - zoom out
# map + zoom in

map R rotate

map r reload
map i recolor

set font "inconsolata 15"
set default-bg "#000000" #00
set default-fg "#F7F7F6" #01

set statusbar-fg "#B0B0B0" #04
set statusbar-bg "#202020" #01

set inputbar-bg "#151515" #00 currently not used
set inputbar-fg "#FFFFFF" #02

set notification-error-bg "#AC4142" #08
set notification-error-fg "#151515" #00

set notification-warning-bg "#AC4142" #08
set notification-warning-fg "#151515" #00

set highlight-color "rgba(244,191,117,0.30)"
set highlight-active-color "rgba(106,159,181,0.40)"

set completion-highlight-fg "#000000" #02
set completion-highlight-bg "#00BCD4B3" #0C

set completion-bg "#30303003" #02
set completion-fg "#FFC107C4" #0C

set notification-bg "#90A959" #0B
set notification-fg "#151515" #00

set recolor true
set recolor-keephue false

set recolor-darkcolor  "#FFFFFF"
set recolor-lightcolor "#272d2e"

# Keybinds

# <Esc> to close notifications
# <Tab> to search mode
# <number>G to goto a page

# notifications
set guioptions ""
set guioptions none
